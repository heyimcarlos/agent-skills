#!/usr/bin/env bash
# install — adapter for tools that don't have a native plugin marketplace.
#
# Usage:
#   bin/install gemini [--user|--project PATH] [--copy]
#   bin/install codex  [--user|--project PATH] [--copy]
#
# Default install mode is symlink. Pass --copy to snapshot files instead.
# --user installs into the user-level config dir; --project installs into PATH/.gemini (or PATH/.codex).
#
# Claude Code is intentionally NOT supported here — install via the plugin marketplace:
#   /plugin marketplace add heyimcarlos/agent-skills
#   /plugin install core@agent-skills
#   /plugin install qrspi@agent-skills

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="${1:-}"
shift || true

SCOPE="user"
SCOPE_PATH=""
MODE="link"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --user) SCOPE="user"; shift ;;
    --project) SCOPE="project"; SCOPE_PATH="${2:?--project requires a path}"; shift 2 ;;
    --copy) MODE="copy"; shift ;;
    --link) MODE="link"; shift ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

die() { echo "error: $*" >&2; exit 1; }

# Place a single source path at a destination using either symlink or copy.
place() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [[ -e "$dst" || -L "$dst" ]]; then
    rm -rf "$dst"
  fi
  if [[ "$MODE" == "link" ]]; then
    ln -s "$src" "$dst"
  else
    cp -r "$src" "$dst"
  fi
}

resolve_dest() {
  local tool="$1"
  if [[ "$SCOPE" == "user" ]]; then
    echo "$HOME/.$tool"
  else
    [[ -n "$SCOPE_PATH" ]] || die "--project requires a path"
    echo "$SCOPE_PATH/.$tool"
  fi
}

install_gemini() {
  local dest; dest="$(resolve_dest gemini)"
  echo "gemini → $dest (mode=$MODE)"
  place "$REPO/core/skills" "$dest/skills"
  mkdir -p "$dest/commands"
  for plugin in core qrspi; do
    place "$REPO/.gemini/commands/$plugin" "$dest/commands/$plugin"
  done
}

install_codex() {
  local dest; dest="$(resolve_dest codex)"
  echo "codex → $dest (mode=$MODE)"
  mkdir -p "$dest/prompts"
  for f in "$REPO/core/commands"/*.md;  do place "$f" "$dest/prompts/core_$(basename "$f")"; done
  for f in "$REPO/qrspi/commands"/*.md; do place "$f" "$dest/prompts/qrspi_$(basename "$f")"; done
  echo "  prompts placed flat with plugin prefix; AGENTS.md should be added per-project"
}

case "$TARGET" in
  gemini) install_gemini ;;
  codex)  install_codex  ;;
  claude)
    cat <<'EOF'
Claude Code installs via the plugin marketplace, not this script:

  /plugin marketplace add heyimcarlos/agent-skills
  /plugin install core@agent-skills
  /plugin install qrspi@agent-skills

See docs/claude-setup.md for details.
EOF
    exit 1
    ;;
  ""|-h|--help)
    sed -n '1,18p' "$0"
    exit 0
    ;;
  *)
    die "unknown target: $TARGET (expected: gemini|codex)"
    ;;
esac

echo "done."
